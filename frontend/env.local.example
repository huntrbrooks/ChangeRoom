# Frontend (Next.js) — local development example
# Copy to: frontend/.env.local

# Critical linkage: points to Render backend in prod, localhost in dev
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...
# Clerk Frontend API host used by the proxy route.
NEXT_PUBLIC_CLERK_FRONTEND_API=clerk.igetdressed.online
# Optional override when Clerk proxying is configured outside the canonical origin
NEXT_PUBLIC_CLERK_PROXY_URL=https://igetdressed.online/__clerk/

# Stripe (server-side)
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Admin (server-side)
ADMIN_API_KEY=replace_me

# DB
DATABASE_URL=postgresql://...

# Gemini (optional; only needed if Next.js server routes call Gemini)
GEMINI_API_KEY=AIza...

# Firecrawl (web scraping for "Try On Any URL" feature)
FIRECRAWL_API_KEY=fc-...
NEXT_PUBLIC_ENABLE_TRYON_FROM_URL=false
NEXT_PUBLIC_ENABLE_MY_OUTFITS=false
FRONTRUNNER_DEMO_PASSWORD=bintang
FRONTRUNNER_DEMO_COOKIE_SECRET=replace_me

# n8n Automation (email sequences and conversion flows)
N8N_EVENTS_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/igetdressed-events
N8N_WEBHOOK_SECRET=your-shared-secret-here

# Credit holds (server-side)
CREDIT_HOLD_TTL_MINUTES=30

# Affiliate Links (for passive revenue from product clicks)
# Join these programs and add your IDs:
# Amazon Associates: https://affiliate-program.amazon.com/
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=
# ASOS Affiliate: https://www.asos.com/affiliate-programme/
NEXT_PUBLIC_ASOS_AFFILIATE_ID=
# ShopStyle Collective: https://www.shopstyle.com/collective
NEXT_PUBLIC_SHOPSTYLE_PID=
# Commission Junction: https://www.cj.com/
NEXT_PUBLIC_CJ_PUBLISHER_ID=
# Impact: https://impact.com/
NEXT_PUBLIC_IMPACT_ID=
