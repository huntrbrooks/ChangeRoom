# Backend (FastAPI) — local development example
# Copy to: backend/.env

# OpenAI API key (required for main try-on generation and OpenAI analysis helpers)
OPENAI_API_KEY=your_openai_key_here

# Gemini API keys (optional; used for rewrite / safety helpers)
GEMINI_API_KEY=your_gemini_key_here
# GOOGLE_API_KEY=your_gemini_key_here

# Model routing
# Keep production pinned to known-good models. Promote newer models intentionally after evals.
# Main try-on image model: gpt-image-2
OPENAI_TRYON_IMAGE_MODEL=gpt-image-2
# OpenRouter fallback for try-on generation when OpenAI billing/quota is exhausted.
# Optional content fallback only runs after OpenAI safety rewrites and keeps a general-audience safety contract.
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_TRYON_IMAGE_MODEL=google/gemini-3.1-flash-image-preview
# OPENROUTER_VISION_MODEL=google/gemini-3.1-flash-lite
# OPENROUTER_TRYON_CONTENT_FALLBACK_ENABLED=0
# OPENROUTER_TRYON_IMAGE_SIZE=1K
# OPENROUTER_TRYON_ASPECT_RATIO=2:3
# xAI/Grok final fallback. Used after OpenRouter failure or NSFW/content-safety blocks.
# XAI_API_KEY=your_xai_key_here
# XAI_TRYON_IMAGE_MODEL=grok-imagine-image-quality
# XAI_TRYON_ASPECT_RATIO=2:3
# XAI_TRYON_RESPONSE_FORMAT=b64_json
# TRYON_PROVIDER_MAX_RETRIES=2
# Optional output controls for try-on generation
# OPENAI_TRYON_IMAGE_SIZE=1024x1536
# OPENAI_TRYON_QUALITY=high
# OPENAI_TRYON_OUTPUT_FORMAT=jpeg
# OPENAI_TRYON_MODERATION=auto
# OPENAI_MODEL_PHOTO_ANALYSIS_MODEL=gpt-5.4-mini
# OPENAI_MODEL_PHOTO_COMPOSITE_MODEL=gpt-image-2
# GEMINI_REWRITE_MODEL=gemini-3-flash-preview
# GEMINI_INTIMATE_DETECT_MODEL=gemini-3-flash-preview
# GEMINI_GARMENT_ANALYZE_MODEL=gemini-3-flash-preview
# GEMINI_USER_ANALYZE_MODEL=gemini-3-flash-preview
# OPENAI_CLOTHING_ANALYZE_MODEL=gpt-5.4
# OPENAI_PREPROCESS_CLOTHING_MODEL=gpt-5-mini-2025-08-07

# Backend auth (optional)
# BACKEND_AUTH_MODE=none  # allowed: none, clerk, api_key, clerk_or_api_key
# BACKEND_API_KEY=replace_me
# CLERK_ISSUER=https://your-clerk-issuer
# CLERK_FRONTEND_API=clerk.igetdressed.online
# CLERK_JWKS_URL=https://your-clerk-issuer/.well-known/jwks.json
# CLERK_AUDIENCE=your-clerk-audience
# CLERK_JWKS_CACHE_SECONDS=300

# CORS allowlist (comma-separated). Include your Vercel domains in production.
# ALLOWED_ORIGINS=http://localhost:3000,https://your-vercel-domain.vercel.app

# Upload limits (bytes)
# MAX_FILE_SIZE=10485760
# MAX_TOTAL_SIZE=52428800
