# Backend (FastAPI) — local development example
# Copy to: backend/.env

# Gemini API key (required for try-on generation)
GEMINI_API_KEY=your_gemini_key_here

# Optional fallback name
# GOOGLE_API_KEY=your_gemini_key_here

# Model routing
# Keep production pinned to known-good models. Promote newer models intentionally after evals.
# Try-on uses auto by default to probe available Gemini image models and cache the strongest option.
GEMINI_TRYON_MODEL=auto
# Optional cache TTL for model auto-selection (seconds)
# GEMINI_TRYON_MODEL_CACHE_TTL_SECONDS=3600
# GEMINI_REWRITE_MODEL=gemini-3-flash-preview
# GEMINI_INTIMATE_DETECT_MODEL=gemini-3-flash-preview
# GEMINI_GARMENT_ANALYZE_MODEL=gemini-3-flash-preview
# GEMINI_USER_ANALYZE_MODEL=gemini-3-flash-preview
# OPENAI_CLOTHING_ANALYZE_MODEL=gpt-4o
# OPENAI_PREPROCESS_CLOTHING_MODEL=gpt-4o-mini

# Backend auth (optional)
# BACKEND_AUTH_MODE=none  # allowed: none, clerk, api_key
# BACKEND_API_KEY=replace_me
# CLERK_ISSUER=https://your-clerk-issuer
# CLERK_JWKS_URL=https://your-clerk-issuer/.well-known/jwks.json
# CLERK_AUDIENCE=your-clerk-audience
# CLERK_JWKS_CACHE_SECONDS=300

# CORS allowlist (comma-separated). Include your Vercel domains in production.
# ALLOWED_ORIGINS=http://localhost:3000,https://your-vercel-domain.vercel.app

# Upload limits (bytes)
# MAX_FILE_SIZE=10485760
# MAX_TOTAL_SIZE=52428800

